# Copy this file to .env and fill in real values before starting the server.
# Never commit your actual .env file.

# Port the server listens on (most hosts set this for you automatically).
PORT=3000

# Any long random string — used to sign admin session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Bcrypt hash of your real admin passcode — never put the plain password here.
# Generate one with: npm run hash-password -- "YourRealPassword"
ADMIN_PASSWORD_HASH=

# Required — Postgres connection string (Supabase's free tier works well).
# Get this from your Supabase project: Settings > Database > Connection string (URI).
# Replace [YOUR-PASSWORD] with your actual database password.
DATABASE_URL=

# Optional — restrict which origin can call this API in production, e.g.:
# ALLOWED_ORIGIN=https://www.twiraa.com
# Leave unset for local dev / quick testing (allows any origin).
ALLOWED_ORIGIN=

# Optional — email notification on every completed assessment (backup copy,
# independent of the database — see README's note on ephemeral disks).
# Uses Web3Forms (https://web3forms.com) — reuse the same access key from
# any other Web3Forms form you already have working; it delivers to
# whatever inbox is already configured against that key, no DNS/domain
# verification needed since it doesn't send "as" your domain.
# WEB3FORMS_ACCESS_KEY=
