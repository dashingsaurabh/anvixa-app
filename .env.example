# Copy this file to .env and fill in real values before starting the server.
# Never commit your actual .env file.

# Port the server listens on (most hosts set this for you automatically).
PORT=3000

# Any long random string — used to sign admin session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Bcrypt hash of your real admin passcode — never put the plain password here.
# Generate one with: npm run hash-password -- "YourRealPassword"
ADMIN_PASSWORD_HASH=

# Optional — where the JSON database file lives. Defaults to ./data/db.json.
# On hosts with ephemeral disks (see README), point this at a mounted persistent volume.
# DB_PATH=/var/data/db.json

# Optional — restrict which origin can call this API in production, e.g.:
# ALLOWED_ORIGIN=https://www.twiraa.com
# Leave unset for local dev / quick testing (allows any origin).
ALLOWED_ORIGIN=

# Optional — email notification on every completed assessment (backup copy,
# independent of the database — see README's note on ephemeral disks).
# Get a key from https://app.sendgrid.com (Settings > API Keys).
# SENDGRID_API_KEY=
# Where the notification is sent. Defaults to hello@twiraa.com.
# NOTIFY_EMAIL=hello@twiraa.com
# The "from" address — MUST be a verified Single Sender or authenticated
# domain in your SendGrid account, or sends will fail. Defaults to NOTIFY_EMAIL.
# FROM_EMAIL=hello@twiraa.com
